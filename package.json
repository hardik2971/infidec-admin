    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
