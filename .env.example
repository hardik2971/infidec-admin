# ------------------------------------------------------------------
# INFIDEC Marketplace Admin — environment variables
# Copy to .env.local for development. Never commit real values.
# ------------------------------------------------------------------

# Firebase web app config (Firebase Console > Project settings > Your apps)
# or: firebase apps:sdkconfig web --project infidec-admin
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=infidec-admin.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=infidec-admin
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=infidec-admin.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase App Check (optional, recommended in production)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Firebase Admin SDK — server only. Use ONE of:
#  (a) path to a service-account JSON (local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./secret/infidec-admin-firebase-private-key.json
#  (b) inline credentials (CI / hosting secrets); keep \n escapes in the key
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#  (c) neither — Application Default Credentials (Firebase App Hosting / Cloud Run)
FIREBASE_STORAGE_BUCKET=infidec-admin.firebasestorage.app

# Session cookie lifetime in days (1-14)
SESSION_COOKIE_DAYS=5

# --- Later phases ---
# ENVATO_PERSONAL_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="INFIDEC <no-reply@infidec.com>"

# AES-256-GCM key (base64, 32 bytes) for integration secrets stored in Firestore.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

# SMTP for email notifications (server-only). For Gmail use an App Password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
